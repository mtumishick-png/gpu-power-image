# ============================================================
# GPU Power Image - Configuration
# Edit these values, then run build.ps1 (Windows) or build.sh
# ============================================================

# Registry: docker.io (Docker Hub), ghcr.io (GitHub), or your own
REGISTRY=docker.io

# Your username on the registry (Docker Hub username or GitHub username)
USERNAME=ty

# Image name
IMAGE_NAME=gpu-power

# Image tag
TAG=latest

# --- Default env vars passed to RunPod pods ---
# These are read by entrypoint.sh on boot

# Root password for SSH + RDP (CHANGE THIS)
RDP_PASS=2015

# WARP: on or off
WARP_MODE=on

# Gaming: true or false
GAMING=false

# Gaming mode: sunshine, parsec, or both
GAMING_MODE=sunshine
